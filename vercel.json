{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/track/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/compensate/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/crunchyroll/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/public/activity", "destination": "/api/public/track?_route=activity" },
    { "source": "/api/public/reviews", "destination": "/api/public/lookup?_route=reviews" },
    { "source": "/api/public/system-settings", "destination": "/api/public/lookup?_route=system-settings" },
    { "source": "/api/public/verify-device", "destination": "/api/public/track?_route=verify-device" },
    { "source": "/api/public/crunchyroll/access", "destination": "/api/public/crunchyroll?_route=access" },
    { "source": "/api/public/crunchyroll/messages", "destination": "/api/public/crunchyroll?_route=messages" },
    { "source": "/api/public/track/:token/reminder-email", "destination": "/api/public/track?_route=reminder-email&token=:token" },
    { "source": "/api/public/track/:token/review", "destination": "/api/public/track?_route=review&token=:token" },
    { "source": "/api/public/track/:token/review-share", "destination": "/api/public/track?_route=review-share&token=:token" },
    { "source": "/api/public/compensate/:token", "destination": "/api/public/compensate?token=:token" },
    { "source": "/api/admin/reviews/:id", "destination": "/api/admin/operations?_route=reviews&id=:id" },
    { "source": "/api/admin/compensations/:id", "destination": "/api/admin/operations?_route=compensations&id=:id" },
    { "source": "/api/admin/products/sync-salla", "destination": "/api/admin/operations?_route=sync-salla" },
    { "source": "/api/cron/renewal-reminders", "destination": "/api/cron?job=renewal-reminders" },
    { "source": "/api/cron/mail-retention", "destination": "/api/cron?job=mail-retention" },
    { "source": "/api/cron/daily-digest", "destination": "/api/cron?job=daily-digest" },
    { "source": "/api/admin/dispute-report", "destination": "/api/admin/operations?_route=dispute-report" },
    { "source": "/api/admin/orders/:id/reset-device", "destination": "/api/admin/operations?_route=reset-device&orderId=:id" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/track/:path*", "destination": "/track.html" },
    { "source": "/compensate/:path*", "destination": "/track.html" }
    ,{ "source": "/crunchyroll", "destination": "/crunchyroll.html" }
    ,{ "source": "/crunchyroll/:path*", "destination": "/crunchyroll.html" }
  ],
  "crons": [
    { "path": "/api/cron/renewal-reminders", "schedule": "0 13 * * *" },
    { "path": "/api/cron/mail-retention", "schedule": "0 14 * * *" },
    { "path": "/api/cron/daily-digest", "schedule": "0 18 * * *" }
  ]
}
